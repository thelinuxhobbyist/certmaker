{
  "name": "certifyfast",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:api": "wrangler dev",
    "build": "npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply certifyfast --local",
    "db:migrate:remote": "wrangler d1 migrations apply certifyfast --remote",
    "types": "wrangler types",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cf-wasm/resvg": "^0.4.0",
    "fflate": "^0.8.3",
    "hono": "^4.7.0",
    "konva": "^9.3.0",
    "papaparse": "^5.5.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@types/papaparse": "^5.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
