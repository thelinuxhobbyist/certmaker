{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "certifyfast",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "certifyfast",
      "database_id": "3cb7d942-b710-40c5-afdb-83a435a3b657",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "certifyfast"
    }
  ],
  "workers_dev": true,
  "routes": [
    { "pattern": "thecertmaker.com", "custom_domain": true },
    { "pattern": "www.thecertmaker.com", "custom_domain": true }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://thecertmaker.com"
  },
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.ttf", "**/*.otf"],
      "fallthrough": true
    }
  ]
}
